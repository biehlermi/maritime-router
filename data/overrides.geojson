   "properties": {
    "id": "ijmuiden_outer_harbour",
    "effect": "force_navigable",
    "reason": "The IJmuiden outer harbour between the pier heads and the Buitenhaven (the approach to the North Sea Canal locks) is mapped as natural=water without a water=* tag (Nieuwe Buitenhaven, Oude Buitenhaven), which the filter does not take (untagged natural=water is mostly lakes and ponds). The coastline closes across the pier heads, so without this override the canal, the locks and Amsterdam are cut off from the sea.",
    "source": [
     "Geometry: OpenStreetMap ways 1105341593 (Nieuwe Buitenhaven) and 1105341590 (Oude Buitenhaven), natural=water, salt=yes, tidal=yes; OpenStreetMap contributors (ODbL), Geofabrik extract of 2026-10-15, unchanged"
    ],
    "note": "Exact OSM water areas, not buffered: their edges shared with the coastline and the Buitenhaven canal polygon join the water union, so no shore is left between them."
   },
